# Copy to .env (git-ignored) and adjust. Docker Compose reads it automatically.
# These are development defaults, never use them in a shared or public environment.

POSTGRES_DB=agilesim
POSTGRES_USER=agilesim
# Both passwords are inserted into connection URLs: use URL-safe characters (no @ : / ? # %).
POSTGRES_PASSWORD=change-me-locally
# Password of the limited login role the API uses (agilesim_app).
POSTGRES_APP_PASSWORD=change-me-too-locally

# Backend (prefix AGILESIM_)
AGILESIM_APP_ENV=development

# Signing key of access tokens (JWT). Required whenever AGILESIM_APP_ENV is not "development";
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# AGILESIM_JWT_SECRET=
